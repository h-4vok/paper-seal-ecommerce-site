---
import ArtworkWatermark from './ArtworkWatermark.astro';

interface Props {
  assetBase: string;
  sourceBase?: string;
  alt: string;
  orientation: 'landscape' | 'portrait';
  imageWidth: number;
  imageHeight: number;
  sizes?: string;
  eager?: boolean;
  watermark?: boolean;
  watermarkProfile?: 'standard' | 'high-contrast';
  resolution?: 720 | 1440;
  srcsetWidths?: readonly (720 | 1440 | 2880)[];
  modernFormat?: 'avif';
  variant?: 'flat' | 'catalogue';
}

const {
  assetBase,
  sourceBase = `/images/artworks/${assetBase}/flat`,
  alt,
  orientation,
  imageWidth,
  imageHeight,
  sizes = '(min-width: 64rem) 42vw, 92vw',
  eager = false,
  watermark = true,
  watermarkProfile = 'standard',
  resolution = 720,
  srcsetWidths = [720, 1440],
  modernFormat,
  variant = 'flat',
} = Astro.props;
const src = `${sourceBase}-${resolution}.jpg`;
const flatSrcset = srcsetWidths.map((width) => `${sourceBase}-${width}.jpg ${width}w`).join(', ');
const modernSrcset = modernFormat
  ? srcsetWidths.map((width) => `${sourceBase}-${width}.${modernFormat} ${width}w`).join(', ')
  : undefined;
const catalogueBase = `/images/artworks/${assetBase}/card`;
const catalogueSrcset = (format: 'webp' | 'jpg') =>
  [480, 960, 1440].map((width) => `${catalogueBase}-${width}.${format} ${width}w`).join(', ');
---

<span class:list={['artwork-picture', `artwork-picture--${orientation}`]}>
  {variant === 'catalogue' ? (
    <picture>
      <source type="image/webp" srcset={catalogueSrcset('webp')} {sizes} />
      <img
        src={`${catalogueBase}-480.jpg`}
        srcset={catalogueSrcset('jpg')}
        {sizes}
        {alt}
        width="480"
        height="360"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : 'auto'}
        data-image-source
      />
    </picture>
  ) : modernFormat ? (
    <picture>
      <source type={`image/${modernFormat}`} srcset={modernSrcset} {sizes} />
      <img
        src={src}
        srcset={flatSrcset}
        {sizes}
        {alt}
        width={imageWidth}
        height={imageHeight}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : 'auto'}
        data-image-source
      />
    </picture>
  ) : (
    <img
      src={src}
      srcset={flatSrcset}
      {sizes}
      {alt}
      width={imageWidth}
      height={imageHeight}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : 'auto'}
      data-image-source
    />
  )}
  <span
    class="artwork-picture__fallback"
    role="img"
    aria-label={alt || 'Product image unavailable'}
    hidden
    data-image-fallback
  >
    Image unavailable
  </span>
  {watermark && <ArtworkWatermark profile={watermarkProfile} />}
</span>

<script>
  document.querySelectorAll<HTMLImageElement>('[data-image-source]').forEach((image) => {
    image.addEventListener(
      'error',
      () => {
        image.hidden = true;
        const picture = image.closest<HTMLElement>('.artwork-picture');
        const fallback = picture?.querySelector<HTMLElement>('[data-image-fallback]');
        if (fallback) fallback.hidden = false;
        picture?.querySelector<HTMLElement>('.artwork-watermark')?.setAttribute('hidden', '');
      },
      { once: true },
    );
  });
</script>
