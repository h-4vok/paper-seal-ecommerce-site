---
interface Props {
  assetBase: string;
  kind?: 'flat' | 'room';
  alt: string;
  sizes?: string;
  eager?: boolean;
}

const {
  assetBase,
  kind = 'room',
  alt,
  sizes = '(min-width: 64rem) 42vw, 92vw',
  eager = false,
} = Astro.props;
const base = `/images/artworks/${assetBase}/${kind}`;
---
<img
    src={`${base}-1440.jpg`}
    srcset={`${base}-720.jpg 720w, ${base}-1440.jpg 1440w`}
    {sizes}
    {alt}
    width="1440"
    height="1080"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : 'auto'}
  />
