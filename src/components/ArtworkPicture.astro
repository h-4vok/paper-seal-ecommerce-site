---
interface Props {
  assetBase: string;
  sourceBase?: string;
  alt: string;
  orientation: 'landscape' | 'portrait';
  imageWidth: number;
  imageHeight: number;
  sizes?: string;
  eager?: boolean;
  watermark?: boolean;
  watermarkProfile?: 'standard' | 'high-contrast';
  resolution?: 720 | 1440;
  variant?: 'flat' | 'catalogue';
}

const {
  assetBase,
  sourceBase = `/images/artworks/${assetBase}/flat`,
  alt,
  orientation,
  imageWidth,
  imageHeight,
  sizes = '(min-width: 64rem) 42vw, 92vw',
  eager = false,
  watermark = true,
  watermarkProfile = 'standard',
  resolution = 720,
  variant = 'flat',
} = Astro.props;
const src = `${sourceBase}-${resolution}.jpg`;
const catalogueBase = `/images/artworks/${assetBase}/card`;
const catalogueSrcset = (format: 'webp' | 'jpg') =>
  [480, 960, 1440].map((width) => `${catalogueBase}-${width}.${format} ${width}w`).join(', ');
const watermarkRows = Array.from({ length: 7 }, (_, index) => index);
---

<span class:list={['artwork-picture', `artwork-picture--${orientation}`]}>
  {variant === 'catalogue' ? (
    <picture>
      <source type="image/webp" srcset={catalogueSrcset('webp')} {sizes} />
      <img
        src={`${catalogueBase}-480.jpg`}
        srcset={catalogueSrcset('jpg')}
        {sizes}
        {alt}
        width="480"
        height="360"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : 'auto'}
        data-image-source
      />
    </picture>
  ) : (
    <img
      src={src}
      srcset={`/images/artworks/${assetBase}/flat-720.jpg 720w, /images/artworks/${assetBase}/flat-1440.jpg 1440w`}
      {sizes}
      {alt}
      width={imageWidth}
      height={imageHeight}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : 'auto'}
      data-image-source
    />
  )}
  <span
    class="artwork-picture__fallback"
    role="img"
    aria-label={alt || 'Product image unavailable'}
    hidden
    data-image-fallback
  >
    Image unavailable
  </span>
  {watermark && (
    <span class="artwork-watermark" data-watermark-profile={watermarkProfile} aria-hidden="true">
      {watermarkRows.map(() => (
        <span class="artwork-watermark__line">
          PAPER SEAL · PAPER SEAL · PAPER SEAL · PAPER SEAL · PAPER SEAL
        </span>
      ))}
    </span>
  )}
</span>

<script>
  document.querySelectorAll<HTMLImageElement>('[data-image-source]').forEach((image) => {
    image.addEventListener(
      'error',
      () => {
        image.hidden = true;
        const fallback = image.parentElement?.querySelector<HTMLElement>('[data-image-fallback]');
        if (fallback) fallback.hidden = false;
        image.parentElement
          ?.querySelector<HTMLElement>('.artwork-watermark')
          ?.setAttribute('hidden', '');
      },
      { once: true },
    );
  });
</script>
