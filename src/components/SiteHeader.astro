---
import BrandMark from './BrandMark.astro';
import { siteCopy } from '../domain/site-copy';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const navItems = siteCopy.navigation.items;

const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---
<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label={siteCopy.brand.homeAriaLabel}>
      <BrandMark />
    </a>

    <nav class="site-header__desktop-nav" aria-label={siteCopy.navigation.primaryLabel}>
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <p class="site-header__note" aria-hidden="true">{siteCopy.brand.headerNote[0]}<br />{siteCopy.brand.headerNote[1]}</p>

    <div class="site-header__actions">
      <a class="icon-link" href="/cart" aria-label="Cart, online shop coming soon" aria-current={currentPath === '/cart' ? 'page' : undefined}>
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <path d="M8.5 10.5h15l1.5 17H7l1.5-17Z" fill="none" stroke="currentColor" stroke-width="1.7" />
          <path d="M12 12V8a4 4 0 0 1 8 0v4" fill="none" stroke="currentColor" stroke-width="1.7" />
        </svg>
        <span class="site-header__cart-count" aria-hidden="true">0</span>
      </a>
      <button
        class="icon-button site-header__menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-menu-open
      >
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <path d="M5 9h22M5 16h22M5 23h22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <dialog class="mobile-menu" id="mobile-navigation" aria-labelledby="mobile-menu-title" data-mobile-menu>
    <div class="mobile-menu__header">
      <p id="mobile-menu-title">{siteCopy.navigation.exploreLabel}</p>
      <form method="dialog">
        <button class="icon-button" type="submit" aria-label="Close menu" data-menu-close>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M7 7l18 18M25 7 7 25" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </button>
      </form>
    </div>
    <nav aria-label="Mobile navigation">
      <ul class="mobile-menu__links">
        {navItems.map((item, index) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <span aria-hidden="true">0{index + 1}</span>{item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="mobile-menu__footer">
      <p>Art prints inspired by East Sussex — made for homes with a story.</p>
      <a href="/contact">{siteCopy.navigation.contactLabel} <span aria-hidden="true">→</span></a>
    </div>
  </dialog>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const menu = header?.querySelector('[data-mobile-menu]');
  const openButton = header?.querySelector('[data-menu-open]');

  if (menu instanceof HTMLDialogElement && openButton instanceof HTMLButtonElement) {
    openButton.addEventListener('click', () => {
      menu.showModal();
      openButton.setAttribute('aria-expanded', 'true');
      const closeButton = menu.querySelector('[data-menu-close]');
      if (closeButton instanceof HTMLButtonElement) closeButton.focus();
    });

    menu.addEventListener('close', () => {
      openButton.setAttribute('aria-expanded', 'false');
      openButton.focus();
    });

    menu.addEventListener('click', (event) => {
      if (event.target === menu) menu.close();
    });
  }
</script>
