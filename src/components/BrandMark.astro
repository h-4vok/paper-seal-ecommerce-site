---
import { Image } from 'astro:assets';
import seal from '../assets/brand/paperseal-seal.png';
import { siteCopy } from '../domain/site-copy';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---
<span
  class:list={['brand-mark', { 'brand-mark--compact': compact }]}
>
  <Image
    class="brand-mark__seal"
    src={seal}
    widths={[64, 96, 128]}
    sizes="64px"
    alt=""
    loading="eager"
  />
  <span class="brand-mark__type">
    <span class="brand-mark__name">{siteCopy.brand.name}</span>
    <span class="brand-mark__descriptor">{siteCopy.brand.descriptor}</span>
  </span>
</span>
