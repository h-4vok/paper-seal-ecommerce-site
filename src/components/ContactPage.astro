---
import type { InstitutionalPage as Page } from '../domain/institutional';

interface Props {
  page: Page;
}

const { page } = Astro.props;
---

<main id="main-content" class="contact-page">
  <header class="contact-page__intro">
    <h1>{page.heading}</h1>
    <p class="contact-page__description">{page.description}</p>
  </header>

  <a
    class="contact-page__whatsapp contact-page__whatsapp--primary"
    href="https://wa.me/447448997200"
  >
    <span class="contact-page__whatsapp-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" focusable="false">
        <path
          d="M12 3.6a8.1 8.1 0 0 0-6.9 12.4L4 20l4.1-1.1A8.1 8.1 0 1 0 12 3.6Z"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.6"
        />
        <path
          d="M9.1 8.5c.2-.4.5-.4.8-.4h.4c.2 0 .3.1.4.4l.6 1.4c.1.2.1.4-.1.6l-.5.6c-.2.2-.1.4 0 .6.4.7 1 1.3 1.7 1.7.2.1.4.1.6-.1l.6-.7c.2-.2.4-.2.6-.1l1.3.6c.2.1.3.2.3.4 0 .4-.2 1-.6 1.3-.5.4-1.1.6-1.7.5-1-.2-2.2-.8-3.3-1.8-1-.9-1.7-2.1-1.9-3.1-.2-.8.1-1.5.7-1.9Z"
          fill="currentColor"
        />
      </svg>
    </span>
    <span class="contact-page__whatsapp-copy">
      <span>OUR MAIN CONTACT CHANNEL</span>
      <strong>Message us on WhatsApp</strong>
      <span>Orders, refunds, bespoke work and collaborations</span>
    </span>
    <span class="contact-page__whatsapp-arrow" aria-hidden="true">
      ↗
    </span>
  </a>

  <section class="contact-page__faqs" aria-labelledby="contact-faq-heading">
    <h2 id="contact-faq-heading">How can we help?</h2>
    {page.sections.map((section, index) => (
      <details class="contact-page__faq">
        <summary>{section.heading}</summary>
        <div class="contact-page__answer">
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          {index === 0 && (
            <nav class="contact-page__links" aria-label="Order information">
              <a href="/delivery">
                Delivery information <span aria-hidden="true">→</span>
              </a>
              <a href="/returns">
                Returns and refunds <span aria-hidden="true">→</span>
              </a>
            </nav>
          )}
          {index === 1 && (
            <a class="contact-page__topic-link" href="/commissions">
              Explore commissions <span aria-hidden="true">→</span>
            </a>
          )}
          {index === 2 && (
            <a class="contact-page__topic-link" href="/collabs">
              Explore collaborations <span aria-hidden="true">→</span>
            </a>
          )}
          {index === 3 && (
            <a
              class="contact-page__topic-link"
              href="/redirect/contact-email"
              data-umami-event="Contact email click"
            >
              hello@paperseal.uk
            </a>
          )}
        </div>
      </details>
    ))}
  </section>

  <nav class="contact-page__social" aria-label="Social media">
    <p>Follow along</p>
    <div class="contact-page__social-links">
      <a
        class="contact-page__social-link"
        href="/redirect/contact-whatsapp"
        target="_blank"
        rel="noreferrer"
        aria-label="WhatsApp"
        data-umami-event="Contact social click"
        data-umami-event-channel="whatsapp"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M12 3.6a8.1 8.1 0 0 0-6.9 12.4L4 20l4.1-1.1A8.1 8.1 0 1 0 12 3.6Z"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.6"
          />
          <path
            d="M9.1 8.5c.2-.4.5-.4.8-.4h.4c.2 0 .3.1.4.4l.6 1.4c.1.2.1.4-.1.6l-.5.6c-.2.2-.1.4 0 .6.4.7 1 1.3 1.7 1.7.2.1.4.1.6-.1l.6-.7c.2-.2.4-.2.6-.1l1.3.6c.2.1.3.2.3.4 0 .4-.2 1-.6 1.3-.5.4-1.1.6-1.7.5-1-.2-2.2-.8-3.3-1.8-1-.9-1.7-2.1-1.9-3.1-.2-.8.1-1.5.7-1.9Z"
            fill="currentColor"
          />
        </svg>
      </a>
      <a
        class="contact-page__social-link"
        href="/redirect/contact-instagram"
        target="_blank"
        rel="noreferrer"
        aria-label="Instagram"
        data-umami-event="Contact social click"
        data-umami-event-channel="instagram"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <rect
            x="3.5"
            y="3.5"
            width="17"
            height="17"
            rx="5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          />
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
          <circle cx="17.5" cy="6.8" r="1.2" fill="currentColor" />
        </svg>
      </a>
      <a
        class="contact-page__social-link"
        href="/redirect/contact-facebook"
        target="_blank"
        rel="noreferrer"
        aria-label="Facebook"
        data-umami-event="Contact social click"
        data-umami-event-channel="facebook"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 6.02 4.39 11.01 10.13 11.85v-8.38H7.08V12h3.05V9.36c0-3.02 1.79-4.7 4.53-4.7 1.31 0 2.69.24 2.69.24v2.95h-1.52c-1.49 0-1.95.93-1.95 1.89V12h3.33l-.53 3.54h-2.8v8.38C19.61 23.08 24 18.09 24 12.07Z"
            fill="currentColor"
          />
        </svg>
      </a>
    </div>
  </nav>
</main>
