---
import type { InstitutionalPage as Page } from '../domain/institutional';

interface Props {
  page: Page;
}

const { page } = Astro.props;
---

<main id="main-content" class="contact-page">
  <header class="contact-page__intro">
    <h1>{page.heading}</h1>
    <p class="contact-page__description">{page.description}</p>
  </header>

  <a class="contact-page__whatsapp" href="https://wa.me/447448997200">
    Message us on WhatsApp <span aria-hidden="true">↗</span>
  </a>

  <section class="contact-page__faqs" aria-labelledby="contact-faq-heading">
    <h2 id="contact-faq-heading">How can we help?</h2>
    {page.sections.map((section, index) => (
      <details class="contact-page__faq">
        <summary>{section.heading}</summary>
        <div class="contact-page__answer">
          {section.paragraphs.map((paragraph) => (
            <p id={index === 3 ? 'contact-email' : undefined}>{paragraph}</p>
          ))}
          {index === 0 && (
            <nav class="contact-page__links" aria-label="Order information">
              <a href="/delivery">
                Delivery information <span aria-hidden="true">→</span>
              </a>
              <a href="/returns">
                Returns and refunds <span aria-hidden="true">→</span>
              </a>
            </nav>
          )}
          {index === 1 && (
            <a class="contact-page__topic-link" href="/commissions">
              Explore commissions <span aria-hidden="true">→</span>
            </a>
          )}
          {index === 2 && (
            <a class="contact-page__topic-link" href="/collabs">
              Explore collaborations <span aria-hidden="true">→</span>
            </a>
          )}
          {index === 3 && (
            <a class="contact-page__topic-link" href="#contact-email" data-contact-email>
              Email the studio <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </details>
    ))}
  </section>

  <section class="contact-page__closing" aria-labelledby="contact-closing-heading">
    <h2 id="contact-closing-heading">Still need a hand?</h2>
    <a class="contact-page__whatsapp" href="https://wa.me/447448997200">
      Message us on WhatsApp <span aria-hidden="true">↗</span>
    </a>
  </section>
</main>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-contact-email]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const address = document
        .querySelector('#contact-email')
        ?.textContent?.replace(' [at] ', '@')
        .replace(' [dot] ', '.');
      if (address) window.location.href = `mailto:${address}`;
    });
  });
</script>
