---
interface Props {
  eyebrow: string;
  heading: string;
  description: string;
}

const { eyebrow, heading, description } = Astro.props;
---
<main id="main-content" class="placeholder-page">
  <div class="placeholder-page__paper">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{heading}</h1>
    <p>{description}</p>
    <p class="placeholder-page__status" role="status">This part of Paperseal is coming soon.</p>
    <a class="text-link" href="/">Return home <span aria-hidden="true">→</span></a>
  </div>
</main>
