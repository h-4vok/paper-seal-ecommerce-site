---
import { copy, copyText } from '../content/copy';
const { navigation, footer } = copy.shared;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="site-footer__lead">
    <p class="eyebrow">{footer.eyebrow}</p>
    
  </div>
  <div class="site-footer__columns">
    <nav aria-label={footer.explore}>
      <p>{footer.explore}</p>
      <a href="/artworks">{footer.allArtworks}</a>
      <a href="/our-story">{footer.ourStory}</a>
      <a href="/east-sussex">{navigation.items[2].label}</a>
      <a href="/journal">{navigation.items[3].label}</a>
    </nav>
    <nav aria-label={footer.goodToKnow}>
      <p>{footer.goodToKnow}</p>
      <a href="/delivery">{footer.delivery}</a>
      <a href="/returns">{footer.returns}</a>
      <a href="/contact">{footer.contact}</a>
    </nav>
    <nav aria-label={footer.smallPrint}>
      <p>{footer.smallPrint}</p>
      <a href="/privacy">{footer.privacy}</a>
      <a href="/terms">{footer.terms}</a>
    </nav>
  </div>
  <div class="site-footer__base">
    <p>{copyText(footer.copyright, { year })}</p>
    <p>{footer.strapline}</p>
  </div>
</footer>
