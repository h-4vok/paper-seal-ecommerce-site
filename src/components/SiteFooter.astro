---
import { copy, copyText } from '../content/copy';
const { navigation, footer } = copy.shared;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__lead">
    <p class="eyebrow">{footer.eyebrow}</p>
  </div>
  <div class="site-footer__columns">
    <nav aria-label={footer.explore}>
      <p>{footer.explore}</p>
      <a href="/artworks">{footer.allArtworks}</a>
      <a href="/our-story">{footer.ourStory}</a>
      <a href={navigation.items[2].href}>{navigation.items[2].label}</a>
      <a href="/commissions">{footer.commissions}</a>
    </nav>
    <nav aria-label={footer.goodToKnow}>
      <p>{footer.goodToKnow}</p>
      <a href="/delivery">{footer.delivery}</a>
      <a href="/returns">{footer.returns}</a>
      <a href="/contact">{footer.contact}</a>
    </nav>
    <nav aria-label={footer.socialMedia}>
      <p>{footer.socialMedia}</p>
      <a
        href="/redirect/contact-whatsapp"
        target="_blank"
        rel="noreferrer"
        data-umami-event="Contact social click"
        data-umami-event-channel="whatsapp"
      >
        {footer.whatsapp}
      </a>
      <a
        href="/redirect/contact-instagram"
        target="_blank"
        rel="noreferrer"
        data-umami-event="Contact social click"
        data-umami-event-channel="instagram"
      >
        {footer.instagram}
      </a>
      <a
        href="/redirect/contact-facebook"
        target="_blank"
        rel="noreferrer"
        data-umami-event="Contact social click"
        data-umami-event-channel="facebook"
      >
        {footer.facebook}
      </a>
    </nav>
    <nav aria-label={footer.smallPrint}>
      <p>{footer.smallPrint}</p>
      <a href="/privacy">{footer.privacy}</a>
      <a href="/terms">{footer.terms}</a>
    </nav>
  </div>
  <div class="site-footer__base">
    <p>{copyText(footer.copyright, { year })}</p>
    <p>{footer.strapline}</p>
  </div>
</footer>
