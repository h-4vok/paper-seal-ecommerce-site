---
interface ContactCopy {
  eyebrow: string;
  heading: string;
  copy: string;
}

interface ContactActions {
  whatsapp: string;
  instagram: string;
}

interface Props {
  page: 'commissions' | 'collabs';
  content: ContactCopy;
  actions: ContactActions;
  linksLabel: string;
  instagramHref: string;
  position: 'top' | 'bottom';
}

const { page, content, actions, linksLabel, instagramHref, position } = Astro.props;
const titleId = `contact-${page}-${position}-title`;
---

<section
  class:list={['commission-contact', `commission-contact--${position}`]}
  aria-labelledby={titleId}
>
  <div class="commission-contact__message">
    <p class="eyebrow">{content.eyebrow}</p>
    <h2 id={titleId}>{content.heading}</h2>
    <p>{content.copy}</p>
  </div>
  <nav class="commission-contact__actions" aria-label={linksLabel}>
    <a
      class="commission-contact__link"
      href="https://wa.me/447448997200"
      target="_blank"
      rel="noreferrer"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M12 3.6a8.1 8.1 0 0 0-6.9 12.4L4 20l4.1-1.1A8.1 8.1 0 1 0 12 3.6Z"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.6"
        />
        <path
          d="M9.1 8.5c.2-.4.5-.4.8-.4h.4c.2 0 .3.1.4.4l.6 1.4c.1.2.1.4-.1.6l-.5.6c-.2.2-.1.4 0 .6.4.7 1 1.3 1.7 1.7.2.1.4.1.6-.1l.6-.7c.2-.2.4-.2.6-.1l1.3.6c.2.1.4.2.4.4 0 .4-.2 1-.6 1.3-.5.4-1.1.6-1.7.5-1-.2-2.2-.8-3.3-1.8-1-.9-1.7-2.1-1.9-3.1-.2-.8.1-1.5.7-1.9Z"
          fill="currentColor"
        />
      </svg>
      <span>{actions.whatsapp}</span>
    </a>
    <a
      class="commission-contact__link"
      href={instagramHref}
      target="_blank"
      rel="noreferrer"
      data-umami-event="Instagram CTA Click"
      data-umami-event-page={page}
      data-umami-event-position={position}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <rect
          x="3.7"
          y="3.7"
          width="16.6"
          height="16.6"
          rx="4.7"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        />
        <circle cx="12" cy="12" r="3.7" fill="none" stroke="currentColor" stroke-width="1.6" />
        <circle cx="17.4" cy="6.9" r="1" fill="currentColor" />
      </svg>
      <span>{actions.instagram}</span>
    </a>
  </nav>
</section>
