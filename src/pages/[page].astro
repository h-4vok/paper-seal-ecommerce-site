---
import InstitutionalPage from '../components/InstitutionalPage.astro';
import ContactPage from '../components/ContactPage.astro';
import { institutionalPages, type InstitutionalPage as Page } from '../domain/institutional';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/institutional.scss';
import '../styles/contact.scss';

export function getStaticPaths() {
  return institutionalPages.map((page) => ({ params: { page: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: Page };
const canonical = `/${page.slug}`;
const siteOrigin = Astro.site ?? Astro.url.origin;
const title = `${page.eyebrow} — The Paper Seal Studio`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', siteOrigin).href },
      {
        '@type': 'ListItem',
        position: 2,
        name: page.eyebrow,
        item: new URL(canonical, siteOrigin).href,
      },
    ],
  },
  ...(page.slug === 'contact'
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'ContactPage',
          name: title,
          description: page.description,
          url: new URL(canonical, siteOrigin).href,
        },
      ]
    : []),
];
---

<BaseLayout
  {title}
  description={page.description}
  {canonical}
  indexable={page.indexable}
  {structuredData}
>
  {page.slug === 'contact' ? <ContactPage {page} /> : <InstitutionalPage {page} />}
</BaseLayout>
