---
import ArtworkPicture from '../components/ArtworkPicture.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/institutional.scss';
import { siteCopy } from '../domain/site-copy';

const { cart } = siteCopy;
const title = cart.title;
const description = cart.description;
const structuredData = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://paperseal.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Cart', item: 'https://paperseal.co.uk/cart' },
  ],
};
---
<BaseLayout {title} {description} canonical="/cart" indexable={false} {structuredData} bodyClass="cart-body">
  <main id="main-content" class="cart-page">
    <section class="cart-paper" aria-labelledby="cart-title">
      <div class="cart-paper__header"><p class="eyebrow">{cart.eyebrow}</p><span aria-hidden="true">{cart.itemCount}</span></div>
      <h1 id="cart-title">{cart.heading}</h1>
      <div class="cart-empty-state">
        <p class="cart-empty-state__title">{cart.emptyTitle}</p>
        <p class="cart-empty-state__copy">{cart.emptyCopy}</p>
        <a class="button-link button-link--navy" href="/artworks">{cart.browseCta} <span aria-hidden="true">→</span></a>
      </div>
    </section>
    <aside class="cart-brand-scene" aria-label={cart.sceneLabel}>
      <div class="cart-brand-scene__tear" aria-hidden="true"></div>
      <ArtworkPicture assetBase="seven-sisters" kind="room" alt={cart.sceneAlt} sizes="(min-width: 56rem) 44vw, 100vw" />
      <div><p class="cart-brand-scene__script">{cart.sceneScript}</p><p>{cart.sceneCopy}</p></div>
    </aside>
  </main>
</BaseLayout>
