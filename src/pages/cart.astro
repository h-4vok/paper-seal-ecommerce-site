---
import ArtworkMockupPicture from '../components/ArtworkMockupPicture.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/institutional.scss';
import { copy } from '../content/copy';
import { artworks } from '../domain/catalogue';

const { cart } = copy;
const title = cart.seo.title;
const description = cart.seo.description;
const siteOrigin = Astro.site ?? Astro.url.origin;
const sceneArtwork = artworks.find(({ assetBase }) => assetBase === 'seven-sisters');
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', siteOrigin).href },
    { '@type': 'ListItem', position: 2, name: 'Cart', item: new URL('/cart', siteOrigin).href },
  ],
};
---

<BaseLayout
  {title}
  {description}
  canonical="/cart"
  indexable={false}
  {structuredData}
  bodyClass="cart-body"
>
  <main id="main-content" class="cart-page">
    <section class="cart-paper" aria-labelledby="cart-title">
      <div class="cart-paper__header">
        <p class="eyebrow">{cart.header.eyebrow}</p>
        <span aria-hidden="true">{cart.header.itemCount}</span>
      </div>
      <h1 id="cart-title">{cart.header.heading}</h1>
      <div class="cart-empty-state">
        <p class="cart-empty-state__title">{cart.empty.title}</p>
        <p class="cart-empty-state__copy">{cart.empty.copy}</p>
        <a class="button-link button-link--navy" href="/artworks">
          {cart.empty.browse} <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
    <aside class="cart-brand-scene" aria-label={cart.scene.label}>
      <div class="cart-brand-scene__tear" aria-hidden="true"></div>
      {sceneArtwork && (
        <ArtworkMockupPicture
          assetBase={sceneArtwork.assetBase}
          size="a3"
          sceneId={sceneArtwork.mockups.a3[0].sceneId}
          alt={cart.scene.alt}
          sizes="(min-width: 56rem) 44vw, 100vw"
        />
      )}
      <div>
        <p class="cart-brand-scene__script">{cart.scene.script}</p>
        <p>{cart.scene.copy}</p>
      </div>
    </aside>
  </main>
</BaseLayout>
