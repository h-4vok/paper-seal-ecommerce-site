---
import ArtworkCard from '../../components/ArtworkCard.astro';
import GreetingCardCard from '../../components/GreetingCardCard.astro';
import CatalogueFamilySwitch from '../../components/CatalogueFamilySwitch.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  artworks,
  catalogueProducts,
  familyPreviewProducts,
  filterCatalogue,
  mockupImagePath,
  productPath,
} from '../../domain/catalogue';
import type { ProductFamily } from '../../domain/product-families';
import { greetingCardImagePath } from '../../domain/greeting-cards';
import { copy } from '../../content/copy';
import '../../styles/catalogue.scss';

const rawCatalogue = copy.catalogue;
const catalogue = {
  title: rawCatalogue.seo.title,
  description: rawCatalogue.seo.description,
  heading: rawCatalogue.intro.heading,
  headingEyebrow: rawCatalogue.intro.eyebrow,
  intro: rawCatalogue.intro.copy,
  familyGroupLabel: rawCatalogue.controls.familyGroupLabel,
  artworksLabel: rawCatalogue.controls.artworksLabel,
  greetingCardsLabel: rawCatalogue.controls.greetingCardsLabel,
  selectedLabel: rawCatalogue.controls.selectedLabel,
  searchLabel: rawCatalogue.controls.searchLabel,
  searchPlaceholder: rawCatalogue.controls.searchPlaceholder,
  sortLabel: rawCatalogue.controls.sortLabel,
  newestLabel: rawCatalogue.controls.newest,
  titleSortLabel: rawCatalogue.controls.title,
  collectionLabel: rawCatalogue.results.label,
  resultCountLabel: rawCatalogue.results.countLabel,
  emptyEyebrow: rawCatalogue.results.emptyEyebrow,
  emptyHeading: rawCatalogue.results.emptyHeading,
  resetLabel: rawCatalogue.results.reset,
  otherFamilyInvite: rawCatalogue.results.otherFamilyInvite,
  otherFamilyAction: rawCatalogue.results.otherFamilyAction,
};
const title = catalogue.title;
const description = catalogue.description;
const siteOrigin = Astro.site ?? Astro.url.origin;
const initialProducts = filterCatalogue(catalogueProducts, {
  query: '',
  family: 'artwork',
  sort: 'newest',
});
const initialVisibleHandles = new Set(initialProducts.slice(0, 4).map(({ handle }) => handle));
const initialFamilyPreviews = (family: ProductFamily) =>
  familyPreviewProducts(catalogueProducts, family).map((product) => ({
    assetBase: product.assetBase,
    sourceBase:
      product.family === 'greeting-card'
        ? greetingCardImagePath(product, 'search', 720).replace(/-720\.jpg$/, '')
        : undefined,
    alt: product.alt,
  }));
const familyPreviews = {
  artwork: initialFamilyPreviews('artwork'),
  'greeting-card': initialFamilyPreviews('greeting-card'),
};
const allProducts = [...catalogueProducts].sort(
  (left, right) => right.publishedOrder - left.publishedOrder || left.sku.localeCompare(right.sku),
);
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'The Paper Seal Studio artworks and greeting cards',
    description,
    url: new URL('/artworks', siteOrigin).href,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: catalogueProducts.map((product, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: product.title,
        url: new URL(productPath(product), siteOrigin).href,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', siteOrigin).href },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Artworks',
        item: new URL('/artworks', siteOrigin).href,
      },
    ],
  },
];
---

<BaseLayout
  {title}
  {description}
  canonical="/artworks"
  image={mockupImagePath(artworks[0], 'a3')}
  {structuredData}
>
  <main
    id="main-content"
    class="catalogue-page"
    data-catalogue
    data-result-label={catalogue.resultCountLabel}
  >
    <section class="catalogue-main" aria-labelledby="catalogue-title">
      <header class="catalogue-intro">
        <div>
          <h1 id="catalogue-title">{catalogue.heading}</h1>
          <p class="eyebrow">{catalogue.headingEyebrow}</p>
        </div>
        <p>{catalogue.intro}</p>
      </header>

      <section
        class="catalogue-family-selector"
        aria-label={catalogue.familyGroupLabel}
        data-family-selector
      >
        <h2 class="visually-hidden">{catalogue.familyGroupLabel}</h2>
        <div
          class="catalogue-family-selector__choices"
          role="group"
          aria-label={catalogue.familyGroupLabel}
        >
          <CatalogueFamilySwitch
            family="artwork"
            label={catalogue.artworksLabel}
            previews={familyPreviews.artwork}
            variant="choice"
            active
            selectedLabel={catalogue.selectedLabel}
          />
          <CatalogueFamilySwitch
            family="greeting-card"
            label={catalogue.greetingCardsLabel}
            previews={familyPreviews['greeting-card']}
            variant="choice"
            selectedLabel={catalogue.selectedLabel}
          />
        </div>
      </section>

      <form class="catalogue-toolbar" role="search" data-catalogue-controls>
        <label class="catalogue-search">
          <span class="visually-hidden">{catalogue.searchLabel}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="10" cy="10" r="6.5" fill="none" stroke="currentColor" stroke-width="1.7" />
            <path d="m15 15 5 5" stroke="currentColor" stroke-width="1.7" />
          </svg>
          <input
            type="search"
            name="q"
            autocomplete="off"
            placeholder={catalogue.searchPlaceholder}
            data-search
          />
        </label>
        <label>
          <span class="catalogue-toolbar__label">{catalogue.sortLabel}</span>
          <select name="sort" aria-label={catalogue.sortLabel} data-sort>
            <option value="newest">{catalogue.newestLabel}</option>
            <option value="title">{catalogue.titleSortLabel}</option>
          </select>
        </label>
      </form>

      <div class="catalogue-results-heading">
        <p class="eyebrow">{catalogue.collectionLabel}</p>
        <p aria-live="polite" aria-atomic="true" data-result-count>
          {initialProducts.length} {catalogue.resultCountLabel}
        </p>
      </div>
      <div class="artwork-grid" data-artwork-grid>
        {allProducts.map((product) =>
          product.family === 'artwork' ? (
            <ArtworkCard
              artwork={product}
              eager={product.handle === initialProducts[0]?.handle}
              initiallyHidden={!initialVisibleHandles.has(product.handle)}
            />
          ) : (
            <GreetingCardCard
              card={product}
              initiallyHidden={!initialVisibleHandles.has(product.handle)}
            />
          ),
        )}
      </div>
      <noscript>
        <style>
          .artwork-card[hidden][data-product-family='artwork'] {
            display: block;
          }
        </style>
      </noscript>
      <div class="catalogue-empty" hidden data-empty-state>
        <p class="eyebrow">{catalogue.emptyEyebrow}</p>
        <h2>{catalogue.emptyHeading}</h2>
        <button class="button-link button-link--navy" type="button" data-reset>
          {catalogue.resetLabel}
        </button>
      </div>
      <div class="catalogue-sentinel" aria-hidden="true" data-sentinel></div>
      <CatalogueFamilySwitch
        family="greeting-card"
        label={catalogue.greetingCardsLabel}
        previews={familyPreviews['greeting-card']}
        variant="invitation"
        invitation={catalogue.otherFamilyInvite.replace('{family}', catalogue.greetingCardsLabel)}
        actionLabel={catalogue.otherFamilyAction}
      />
      <CatalogueFamilySwitch
        family="artwork"
        label={catalogue.artworksLabel}
        previews={familyPreviews.artwork}
        variant="invitation"
        invitation={catalogue.otherFamilyInvite.replace('{family}', catalogue.artworksLabel)}
        actionLabel={catalogue.otherFamilyAction}
      />
    </section>
  </main>
</BaseLayout>

<script>
  import {
    catalogueProducts,
    filterCatalogue,
    nextVisibleCount,
    type CatalogueState,
  } from '../../domain/catalogue';
  import { productFamilyFromQuery } from '../../domain/product-families';

  const root = document.querySelector('[data-catalogue]');
  const resultCountLabel = root?.getAttribute('data-result-label') ?? 'artworks';
  const form = root?.querySelector('[data-catalogue-controls]');
  const search = root?.querySelector('[data-search]');
  const sort = root?.querySelector('[data-sort]');
  const familyChoices = [
    ...(root?.querySelectorAll<HTMLButtonElement>('[data-family-choice]') ?? []),
  ];
  const familyInvitations = [
    ...(root?.querySelectorAll<HTMLButtonElement>('[data-family-invitation]') ?? []),
  ];
  const grid = root?.querySelector('[data-artwork-grid]');
  const count = root?.querySelector('[data-result-count]');
  const empty = root?.querySelector('[data-empty-state]');
  const reset = root?.querySelector('[data-reset]');
  const sentinel = root?.querySelector('[data-sentinel]');
  const cardMap = new Map(
    [...(grid?.querySelectorAll<HTMLElement>('[data-artwork-card]') ?? [])].map((card) => [
      card.dataset.handle ?? '',
      card,
    ]),
  );
  const hasInfiniteScroll = 'IntersectionObserver' in window;
  let visibleCount = hasInfiniteScroll ? 4 : Number.MAX_SAFE_INTEGER;
  let currentMatches = catalogueProducts;
  const controlsReady =
    form instanceof HTMLFormElement &&
    search instanceof HTMLInputElement &&
    sort instanceof HTMLSelectElement &&
    grid instanceof HTMLElement &&
    count instanceof HTMLElement &&
    empty instanceof HTMLElement;

  function readState(): CatalogueState {
    return {
      query: search instanceof HTMLInputElement ? search.value : '',
      family:
        familyChoices.find((choice) => choice.getAttribute('aria-pressed') === 'true')?.dataset
          .family === 'greeting-card'
          ? 'greeting-card'
          : 'artwork',
      sort: sort instanceof HTMLSelectElement && sort.value === 'title' ? 'title' : 'newest',
    };
  }
  function updateUrl(state: CatalogueState) {
    const params = new URLSearchParams();
    if (state.query) params.set('q', state.query);
    if (state.family !== 'artwork') params.set('family', state.family);
    if (state.sort !== 'newest') params.set('sort', state.sort);
    history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}`);
  }
  function render({ announce = true } = {}) {
    if (!controlsReady) return;
    const state = readState();
    currentMatches = filterCatalogue(catalogueProducts, state);
    for (const choice of familyChoices) {
      const selected = choice.dataset.family === state.family;
      choice.setAttribute('aria-pressed', String(selected));
      choice.classList.toggle('is-active', selected);
    }
    currentMatches.forEach((artwork) => {
      const card = cardMap.get(artwork.handle);
      if (card) grid.append(card);
    });
    const matchedHandles = new Set(currentMatches.map(({ handle }) => handle));
    for (const [handle, card] of cardMap) {
      const resultIndex = currentMatches.findIndex((artwork) => artwork.handle === handle);
      card.hidden = !matchedHandles.has(handle) || resultIndex >= visibleCount;
    }
    count.textContent = `${currentMatches.length} ${resultCountLabel}`;
    count.setAttribute('aria-live', announce ? 'polite' : 'off');
    empty.hidden = currentMatches.length !== 0;
    if (sentinel instanceof HTMLElement) sentinel.hidden = currentMatches.length <= visibleCount;
    const otherFamily = state.family === 'artwork' ? 'greeting-card' : 'artwork';
    familyInvitations.forEach((invitation) => {
      invitation.hidden =
        invitation.dataset.family !== otherFamily || currentMatches.length > visibleCount;
    });
    updateUrl(state);
  }
  if (controlsReady) {
    const params = new URLSearchParams(location.search);
    search.value = params.get('q') ?? '';
    const initialFamily = productFamilyFromQuery(params.get('family'));
    for (const choice of familyChoices) {
      const selected = choice.dataset.family === initialFamily;
      choice.setAttribute('aria-pressed', String(selected));
      choice.classList.toggle('is-active', selected);
    }
    sort.value = params.get('sort') === 'title' ? 'title' : 'newest';
    render({ announce: false });
    const update = () => {
      visibleCount = hasInfiniteScroll ? 4 : Number.MAX_SAFE_INTEGER;
      render();
    };
    form.addEventListener('input', update);
    form.addEventListener('change', update);
    form.addEventListener('submit', (event) => event.preventDefault());
    familyChoices.forEach((choice) => {
      choice.addEventListener('click', () => {
        const requestedFamily = choice.dataset.family;
        if (requestedFamily !== 'artwork' && requestedFamily !== 'greeting-card') return;
        for (const familyChoice of familyChoices) {
          const selected = familyChoice.dataset.family === requestedFamily;
          familyChoice.setAttribute('aria-pressed', String(selected));
          familyChoice.classList.toggle('is-active', selected);
        }
        visibleCount = hasInfiniteScroll ? 4 : Number.MAX_SAFE_INTEGER;
        render();
      });
    });
    familyInvitations.forEach((familyInvitation) =>
      familyInvitation.addEventListener('click', () => {
        const requestedFamily = familyInvitation.dataset.family;
        if (requestedFamily !== 'artwork' && requestedFamily !== 'greeting-card') return;
        for (const choice of familyChoices) {
          const selected = choice.dataset.family === requestedFamily;
          choice.setAttribute('aria-pressed', String(selected));
          choice.classList.toggle('is-active', selected);
        }
        visibleCount = hasInfiniteScroll ? 4 : Number.MAX_SAFE_INTEGER;
        render();
        root?.scrollIntoView({
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
            ? 'auto'
            : 'smooth',
          block: 'start',
        });
        familyChoices
          .find((choice) => choice.dataset.family === requestedFamily)
          ?.focus({
            preventScroll: true,
          });
      }),
    );
    reset?.addEventListener('click', () => {
      form.reset();
      visibleCount = 4;
      render();
      search.focus();
    });
    if (sentinel && hasInfiniteScroll) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (
            entries.some(({ isIntersecting }) => isIntersecting) &&
            visibleCount < currentMatches.length
          ) {
            visibleCount = nextVisibleCount(visibleCount, currentMatches.length);
            render({ announce: false });
          }
        },
        { rootMargin: '400px 0px' },
      );
      observer.observe(sentinel);
    } else {
      render({ announce: false });
    }
    history.scrollRestoration = 'auto';
  }
</script>
