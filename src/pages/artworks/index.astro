---
import ArtworkCard from '../../components/ArtworkCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { artworks } from '../../domain/catalogue';
import { copy } from '../../content/copy';
import '../../styles/catalogue.scss';

const rawCatalogue = copy.catalogue;
const catalogue = {
  title: rawCatalogue.seo.title,
  description: rawCatalogue.seo.description,
  asideLabel: rawCatalogue.aside.label,
  allLabel: rawCatalogue.aside.all,
  softLaunchLabel: rawCatalogue.aside.softLaunch,
  placeLabel: rawCatalogue.aside.place,
  asideEyebrow: rawCatalogue.aside.eyebrow,
  asideQuote: rawCatalogue.aside.quote,
  sealLines: rawCatalogue.aside.sealLines,
  heading: rawCatalogue.intro.heading,
  headingEyebrow: rawCatalogue.intro.eyebrow,
  intro: rawCatalogue.intro.copy,
  searchLabel: rawCatalogue.controls.searchLabel,
  searchPlaceholder: rawCatalogue.controls.searchPlaceholder,
  placeFilterLabel: rawCatalogue.controls.placeLabel,
  allPlacesLabel: rawCatalogue.controls.allPlaces,
  availabilityLabel: rawCatalogue.controls.availabilityLabel,
  availabilityBadge: rawCatalogue.controls.availabilityBadge,
  availabilityNote: rawCatalogue.controls.availabilityNote,
  sortLabel: rawCatalogue.controls.sortLabel,
  newestLabel: rawCatalogue.controls.newest,
  titleSortLabel: rawCatalogue.controls.title,
  collectionLabel: rawCatalogue.results.label,
  resultCountLabel: rawCatalogue.results.countLabel,
  emptyEyebrow: rawCatalogue.results.emptyEyebrow,
  emptyHeading: rawCatalogue.results.emptyHeading,
  resetLabel: rawCatalogue.results.reset,
};
const title = catalogue.title;
const description = catalogue.description;
const places = [...new Set(artworks.map(({ placeName }) => placeName))].sort((a, b) => a.localeCompare(b, 'en-GB'));
const structuredData = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'The Paper Seal Studio artworks', description,
    url: 'https://paperseal.co.uk/artworks',
    mainEntity: { '@type': 'ItemList', itemListElement: artworks.map((artwork, index) => ({
      '@type': 'ListItem', position: index + 1, name: artwork.title,
      url: `https://paperseal.co.uk/artworks/${artwork.handle}`,
    })) },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://paperseal.co.uk/' },
      { '@type': 'ListItem', position: 2, name: 'Artworks', item: 'https://paperseal.co.uk/artworks' },
    ],
  },
];
---
<BaseLayout {title} {description} canonical="/artworks" image="/images/artworks/flower-bed/room-1440.jpg" {structuredData}>
  <main id="main-content" class="catalogue-page" data-catalogue data-result-label={catalogue.resultCountLabel}>
    <aside class="catalogue-aside" aria-label={catalogue.asideLabel}>
      <nav>
        <a href="/artworks" aria-current="page">{catalogue.allLabel}</a>
        <a href="/artworks?q=Soft+Launch">{catalogue.softLaunchLabel}</a>
        <a href="/artworks?place=Eastbourne">{catalogue.placeLabel}</a>
      </nav>
      <div class="catalogue-aside__sketch" aria-hidden="true">⌁ 〰 ⌁</div>
      <p class="eyebrow">{catalogue.asideEyebrow[0]}<br />{catalogue.asideEyebrow[1]}</p>
      <blockquote>{catalogue.asideQuote}</blockquote>
      <div class="catalogue-aside__seal" aria-hidden="true">
        <span>{rawCatalogue.aside.sealName}</span>
        {catalogue.sealLines.map((line, index) => <>{index > 0 && <br />}{line}</>)}
      </div>
    </aside>

    <section class="catalogue-main" aria-labelledby="catalogue-title">
      <header class="catalogue-intro">
        <div><h1 id="catalogue-title">{catalogue.heading}</h1><p class="eyebrow">{catalogue.headingEyebrow}</p></div>
        <p>{catalogue.intro}</p>
      </header>

      <form class="catalogue-toolbar" role="search" data-catalogue-controls>
        <label class="catalogue-search">
          <span class="visually-hidden">{catalogue.searchLabel}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m15 15 5 5" stroke="currentColor" stroke-width="1.7"/></svg>
          <input type="search" name="q" autocomplete="off" placeholder={catalogue.searchPlaceholder} data-search />
        </label>
        <label><span class="catalogue-toolbar__label">{catalogue.placeFilterLabel}</span><select name="place" aria-label={catalogue.placeFilterLabel} data-place><option value="all">{catalogue.allPlacesLabel}</option>{places.map((place) => <option value={place}>{place}</option>)}</select></label>
        <button class="catalogue-availability" type="button" aria-disabled="true" aria-describedby="availability-note">{catalogue.availabilityLabel} <span class="catalogue-availability__badge">{catalogue.availabilityBadge}</span></button>
        <span id="availability-note" class="visually-hidden">{catalogue.availabilityNote}</span>
        <label><span class="catalogue-toolbar__label">{catalogue.sortLabel}</span><select name="sort" aria-label={catalogue.sortLabel} data-sort><option value="newest">{catalogue.newestLabel}</option><option value="title">{catalogue.titleSortLabel}</option></select></label>
      </form>

      <div class="catalogue-results-heading"><p class="eyebrow">{catalogue.collectionLabel}</p><p aria-live="polite" aria-atomic="true" data-result-count>{artworks.length} {catalogue.resultCountLabel}</p></div>
      <div class="artwork-grid" data-artwork-grid>{artworks.map((artwork, index) => <ArtworkCard {artwork} eager={index < 2} />)}</div>
      <div class="catalogue-empty" hidden data-empty-state>
        <p class="eyebrow">{catalogue.emptyEyebrow}</p><h2>{catalogue.emptyHeading}</h2>
        <button class="button-link button-link--navy" type="button" data-reset>{catalogue.resetLabel}</button>
      </div>
      <div class="catalogue-sentinel" aria-hidden="true" data-sentinel></div>
    </section>
  </main>
</BaseLayout>

<script>
  import { artworks, filterCatalogue, nextVisibleCount, type CatalogueState } from '../../domain/catalogue';

  const root = document.querySelector('[data-catalogue]');
  const resultCountLabel = root?.getAttribute('data-result-label') ?? 'artworks';
  const form = root?.querySelector('[data-catalogue-controls]');
  const search = root?.querySelector('[data-search]');
  const place = root?.querySelector('[data-place]');
  const sort = root?.querySelector('[data-sort]');
  const grid = root?.querySelector('[data-artwork-grid]');
  const count = root?.querySelector('[data-result-count]');
  const empty = root?.querySelector('[data-empty-state]');
  const reset = root?.querySelector('[data-reset]');
  const sentinel = root?.querySelector('[data-sentinel]');
  const cardMap = new Map([...(grid?.querySelectorAll<HTMLElement>('[data-artwork-card]') ?? [])].map((card) => [card.dataset.handle ?? '', card]));
  let visibleCount = 4;
  let currentMatches = artworks;
  const controlsReady = form instanceof HTMLFormElement && search instanceof HTMLInputElement && place instanceof HTMLSelectElement && sort instanceof HTMLSelectElement && grid instanceof HTMLElement && count instanceof HTMLElement && empty instanceof HTMLElement;

  function readState(): CatalogueState {
    return {
      query: search instanceof HTMLInputElement ? search.value : '',
      place: place instanceof HTMLSelectElement ? place.value : 'all',
      sort: sort instanceof HTMLSelectElement && sort.value === 'title' ? 'title' : 'newest',
    };
  }
  function updateUrl(state: CatalogueState) {
    const params = new URLSearchParams();
    if (state.query) params.set('q', state.query);
    if (state.place !== 'all') params.set('place', state.place);
    if (state.sort !== 'newest') params.set('sort', state.sort);
    history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}`);
  }
  function render({ announce = true } = {}) {
    if (!controlsReady) return;
    const state = readState();
    currentMatches = filterCatalogue(artworks, state);
    currentMatches.forEach((artwork) => { const card = cardMap.get(artwork.handle); if (card) grid.append(card); });
    const matchedHandles = new Set(currentMatches.map(({ handle }) => handle));
    for (const [handle, card] of cardMap) {
      const resultIndex = currentMatches.findIndex((artwork) => artwork.handle === handle);
      card.hidden = !matchedHandles.has(handle) || resultIndex >= visibleCount;
    }
    count.textContent = `${currentMatches.length} ${resultCountLabel}`;
    count.setAttribute('aria-live', announce ? 'polite' : 'off');
    empty.hidden = currentMatches.length !== 0;
    if (sentinel instanceof HTMLElement) sentinel.hidden = currentMatches.length <= visibleCount;
    updateUrl(state);
  }
  if (controlsReady) {
    const params = new URLSearchParams(location.search);
    search.value = params.get('q') ?? '';
    const requestedPlace = params.get('place') ?? 'all';
    place.value = [...place.options].some(({ value }) => value === requestedPlace) ? requestedPlace : 'all';
    sort.value = params.get('sort') === 'title' ? 'title' : 'newest';
    render({ announce: false });
    const update = () => { visibleCount = 4; render(); };
    form.addEventListener('input', update);
    form.addEventListener('change', update);
    form.addEventListener('submit', (event) => event.preventDefault());
    reset?.addEventListener('click', () => { form.reset(); visibleCount = 4; render(); search.focus(); });
    if (sentinel && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some(({ isIntersecting }) => isIntersecting) && visibleCount < currentMatches.length) {
          visibleCount = nextVisibleCount(visibleCount, currentMatches.length); render({ announce: false });
        }
      }, { rootMargin: '400px 0px' });
      observer.observe(sentinel);
    }
    history.scrollRestoration = 'auto';
  }
</script>
