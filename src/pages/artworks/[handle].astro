---
import ArtworkPicture from '../../components/ArtworkPicture.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { artworks, productStructuredData, type Artwork } from '../../domain/catalogue';
import { copy, copyText } from '../../content/copy';
import '../../styles/product.scss';

export function getStaticPaths() {
  return artworks.map((artwork) => ({ params: { handle: artwork.handle }, props: { artwork } }));
}

const { artwork } = Astro.props as { artwork: Artwork };
const { product } = copy;
const productLabels = product.labels;
const canonical = `/artworks/${artwork.handle}`;
const shareImage = `/images/artworks/${artwork.assetBase}/room-1440.jpg`;
const title = `${artwork.title} — East Sussex art print | Paperseal`;
const description = `${artwork.description} Explore this Paperseal print inspired by ${artwork.placeName}.`;
const structuredData = [
  productStructuredData(artwork, `https://paperseal.co.uk${canonical}`, `https://paperseal.co.uk${shareImage}`),
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://paperseal.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Artworks', item: 'https://paperseal.co.uk/artworks' },
    { '@type': 'ListItem', position: 3, name: artwork.title, item: `https://paperseal.co.uk${canonical}` },
  ] },
];
const galleryLabels = {
  flat: (title: string) => `${title} artwork image`,
  room: (title: string) => `${title} presented in a room setting`,
};
const gallery = [{ kind: 'flat' as const, label: galleryLabels.flat(artwork.title) }, ...artwork.gallery.map((kind) => ({ kind, label: galleryLabels[kind](artwork.title) }))];
---
<BaseLayout {title} {description} {canonical} image={shareImage} imageAlt={`${artwork.title}, presented as a Paperseal print`} ogType="product" {structuredData} bodyClass="product-body">
  <main id="main-content" class="product-page" data-product-page data-selection-suffix={productLabels.selectionSuffix} data-link-copied={productLabels.linkCopied} data-share-opened={productLabels.shareOpened} data-size-options={JSON.stringify(product.sizes)} data-framing-options={JSON.stringify(product.framing)}>
    <nav class="product-breadcrumbs" aria-label={productLabels.breadcrumb}><a href="/artworks">{productLabels.breadcrumbLink}</a><span aria-hidden="true">/</span><span aria-current="page">{artwork.title}</span></nav>
    <section class="product-layout">
      <div class="product-gallery" data-gallery aria-label={`${artwork.title} ${productLabels.gallery}`}>
        <div class="product-gallery__stage" data-gallery-stage tabindex="0" aria-roledescription="carousel">
          {gallery.map((image, index) => (
            <div class="product-gallery__slide" data-slide={index} hidden={index !== 0}>
              <button class="product-gallery__zoom-trigger" type="button" aria-label={copyText(productLabels.openImage, { image: image.label })} data-gallery-zoom>
                <ArtworkPicture assetBase={artwork.assetBase} kind={image.kind} alt={image.label} sizes="(min-width: 64rem) 62vw, 100vw" eager={index === 0} />
              </button>
            </div>
          ))}
          {gallery.length > 1 && <button class="gallery-arrow gallery-arrow--previous" type="button" aria-label={productLabels.previousImage} data-gallery-previous>←</button>}
          {gallery.length > 1 && <button class="gallery-arrow gallery-arrow--next" type="button" aria-label={productLabels.nextImage} data-gallery-next>→</button>}
        </div>
        {gallery.length > 1 && <div class="product-gallery__dots" aria-label={productLabels.chooseGalleryImage}>
          {gallery.map((image, index) => <button type="button" aria-label={copyText(productLabels.showImage, { number: index + 1, image: image.label })} aria-pressed={index === 0 ? 'true' : 'false'} data-gallery-dot={index}><span class="visually-hidden">{image.label}</span></button>)}
        </div>}
        {gallery.length > 1 && <div class="product-gallery__thumbs">
          {gallery.map((image, index) => (
            <button type="button" class="product-gallery__thumbnail" aria-label={copyText(productLabels.showImage, { number: index + 1, image: image.label })} aria-pressed={index === 0 ? 'true' : 'false'} data-gallery-thumbnail={index}>
              <ArtworkPicture assetBase={artwork.assetBase} kind={image.kind} alt="" sizes="8rem" />
            </button>
          ))}
        </div>}
      </div>

      <article class="product-information">
        <p class="eyebrow">{artwork.collections[0]} · {artwork.artworkCode}</p>
        <h1>{artwork.title}</h1>
        <a class="product-place" href={`/artworks?place=${encodeURIComponent(artwork.placeName)}`}>{artwork.placeName}{productLabels.placeSuffix}</a>
        <p class="product-description">{artwork.description}</p>
    <form class="product-options" data-product-options>
          <fieldset><legend>{productLabels.size}</legend><div class="option-grid option-grid--three">
            {product.sizes.map((size, index) => <label><input type="radio" name="size" value={size.id} checked={index === 0} /><span><strong>{size.label}</strong><small>{size.dimensions}</small></span></label>)}
          </div></fieldset>
          <fieldset><legend>{productLabels.framing}</legend><div class="option-grid option-grid--two">
            {product.framing.map((frame, index) => <label><input type="radio" name="framing" value={frame.id} checked={index === 0} /><span><strong>{frame.label}</strong><small>{frame.detail}</small></span></label>)}
          </div></fieldset>
          <p class="option-announcement" aria-live="polite" data-option-announcement>{product.sizes[0].label}, {product.sizes[0].dimensions}, {product.framing[0].label}{productLabels.selectionSuffix}</p>
        </form>
        <section class="commerce-coming-soon" aria-labelledby="commerce-title">
          <p class="eyebrow" id="commerce-title">{productLabels.commerceEyebrow}</p>
          <p class="commerce-coming-soon__title" tabindex="0">{productLabels.noStock}</p>
          <p>{productLabels.commerceCopy}</p>
        </section>
        <div class="product-actions" aria-label={productLabels.shareGroup}>
          <button class="text-link" type="button" data-share>{productLabels.share}</button><button class="text-link" type="button" data-copy-link>{productLabels.copyLink}</button>
          <p class="visually-hidden" aria-live="polite" data-share-status></p>
        </div>
        <dl class="product-trust">
          <div><dt>{productLabels.printSizes}</dt><dd>{productLabels.printSizesValue}</dd></div><div><dt>{productLabels.presentation}</dt><dd>{productLabels.presentationValue}</dd></div><div><dt>{productLabels.ordering}</dt><dd>{productLabels.orderingValue}</dd></div>
        </dl>
        <p class="product-policy-links"><a href="/delivery">{productLabels.delivery}</a> · <a href="/returns">{productLabels.returns}</a></p>
      </article>
    </section>
    <dialog class="product-lightbox" data-lightbox aria-label={productLabels.lightbox}>
      <div class="product-lightbox__surface" data-lightbox-surface>
        <img data-lightbox-image alt="" />
      </div>
    </dialog>
  </main>
</BaseLayout>

<script>
  import { galleryIndex } from '../../domain/catalogue';
  const productRoot = document.querySelector('[data-product-page]');
  const selectionSuffix = productRoot?.getAttribute('data-selection-suffix') ?? '';
  const sizeOptions = JSON.parse(productRoot?.getAttribute('data-size-options') ?? '[]') as Array<{ id: string; label: string; dimensions: string }>;
  const framingOptions = JSON.parse(productRoot?.getAttribute('data-framing-options') ?? '[]') as Array<{ id: string; label: string }>;
  const linkCopiedMessage = productRoot?.getAttribute('data-link-copied') ?? '';
  const shareOpenedMessage = productRoot?.getAttribute('data-share-opened') ?? '';
  const gallery = document.querySelector('[data-gallery]');
  const stage = gallery?.querySelector('[data-gallery-stage]');
  const slides = [...(gallery?.querySelectorAll<HTMLElement>('[data-slide]') ?? [])];
  const controls = [...(gallery?.querySelectorAll<HTMLButtonElement>('[data-gallery-dot], [data-gallery-thumbnail]') ?? [])];
  const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const lightboxSurface = lightbox?.querySelector<HTMLElement>('[data-lightbox-surface]');
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>('[data-lightbox-image]');
  let current = 0;
  let touchStart = 0;
  function showSlide(index: number) {
    current = index;
    slides.forEach((slide, slideIndex) => { slide.hidden = slideIndex !== current; });
    controls.forEach((control) => { const controlIndex = Number(control.dataset.galleryDot ?? control.dataset.galleryThumbnail); control.setAttribute('aria-pressed', String(controlIndex === current)); });
  }
  function openLightbox(slide: HTMLElement) {
    const image = slide.querySelector<HTMLImageElement>('img');
    if (!image || !lightbox || !lightboxImage) return;
    lightboxImage.src = image.currentSrc || image.src;
    lightboxImage.alt = image.alt;
    lightbox.showModal();
  }
  function closeLightbox() { if (lightbox?.open) lightbox.close(); }
  gallery?.querySelectorAll<HTMLElement>('[data-gallery-zoom]').forEach((trigger) => trigger.addEventListener('click', () => openLightbox(trigger.closest<HTMLElement>('[data-slide]')!)));
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox || event.target === lightboxSurface) closeLightbox();
  });
  lightbox?.addEventListener('cancel', (event) => { event.preventDefault(); closeLightbox(); });
  controls.forEach((control) => control.addEventListener('click', () => showSlide(Number(control.dataset.galleryDot ?? control.dataset.galleryThumbnail))));
  gallery?.querySelector('[data-gallery-previous]')?.addEventListener('click', () => showSlide(galleryIndex(current, slides.length, -1)));
  gallery?.querySelector('[data-gallery-next]')?.addEventListener('click', () => showSlide(galleryIndex(current, slides.length, 1)));
  stage?.addEventListener('keydown', (event) => { const key = (event as KeyboardEvent).key; if (key === 'ArrowLeft') showSlide(galleryIndex(current, slides.length, -1)); if (key === 'ArrowRight') showSlide(galleryIndex(current, slides.length, 1)); });
  stage?.addEventListener('touchstart', (event) => { touchStart = (event as TouchEvent).touches[0]?.clientX ?? 0; }, { passive: true });
  stage?.addEventListener('touchend', (event) => { const distance = ((event as TouchEvent).changedTouches[0]?.clientX ?? touchStart) - touchStart; if (Math.abs(distance) > 45) showSlide(galleryIndex(current, slides.length, distance < 0 ? 1 : -1)); }, { passive: true });

  const optionForm = document.querySelector('[data-product-options]');
  const optionAnnouncement = optionForm?.querySelector('[data-option-announcement]');
  optionForm?.addEventListener('change', () => {
    if (!(optionForm instanceof HTMLFormElement) || !(optionAnnouncement instanceof HTMLElement)) return;
    const data = new FormData(optionForm);
    const size = sizeOptions.find((option) => option.id === data.get('size'));
    const frame = framingOptions.find((option) => option.id === data.get('framing'));
    optionAnnouncement.textContent = `${size ? `${size.label}, ${size.dimensions}` : ''}, ${frame?.label ?? ''}${selectionSuffix}`;
  });
  const shareStatus = document.querySelector('[data-share-status]');
  async function copyLink() { await navigator.clipboard.writeText(location.href); if (shareStatus instanceof HTMLElement) shareStatus.textContent = linkCopiedMessage; }
  document.querySelector('[data-copy-link]')?.addEventListener('click', () => void copyLink());
  document.querySelector('[data-share]')?.addEventListener('click', async () => {
    if (navigator.share) {
      try { await navigator.share({ title: document.title, url: location.href }); if (shareStatus instanceof HTMLElement) shareStatus.textContent = shareOpenedMessage; }
      catch (error) { if (error instanceof DOMException && error.name === 'AbortError') return; await copyLink(); }
    } else await copyLink();
  });
</script>
