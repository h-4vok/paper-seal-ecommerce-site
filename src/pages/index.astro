---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImage from '../assets/home/hero-eastbourne-flower-bed.jpg';
import beachHutsImage from '../assets/home/current-beach-huts.jpg';
import harbourImage from '../assets/home/current-sovereign-harbour.jpg';
import '../styles/home.scss';
import { artworks } from '../domain/catalogue';
import { copy } from '../content/copy';

const { home } = copy;
const title = home.seo.title;
const description = home.seo.description;
const collectionHeading = home.collection.heading;
const browseHeading = home.browse.heading;
const browseAnnotation = home.browse.annotation;
const [featuredBeachHuts, featuredHarbour] = [
  artworks.find((artwork) => artwork.artworkCode === 'PS-007'),
  artworks.find((artwork) => artwork.artworkCode === 'PS-003'),
];
if (!featuredBeachHuts || !featuredHarbour) throw new Error('Featured home artworks are missing from the catalogue.');
const canonical = new URL('/', Astro.site ?? Astro.url.origin).href;
const socialImage = new URL(heroImage.src, Astro.site ?? Astro.url.origin).href;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Paperseal',
    url: canonical,
    description,
    areaServed: 'United Kingdom',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Paperseal',
    url: canonical,
    inLanguage: 'en-GB',
  },
];
---
<BaseLayout
  {title}
  {description}
  {canonical}
  image={socialImage}
  {structuredData}
  bodyClass="home-page"
>
  <main id="main-content">
    <section class="home-hero" aria-labelledby="home-hero-title">
      <div class="home-hero__copy">
        <p class="eyebrow">{home.hero.eyebrow}</p>
        <h1 id="home-hero-title">{home.hero.heading}</h1>
        <p class="home-hero__intro">{home.hero.intro}</p>
        <a class="button-link" href="/artworks">
          {home.hero.cta} <span aria-hidden="true">→</span>
        </a>
      </div>

      <figure class="home-hero__art">
        <Picture
          src={heroImage}
          widths={[480, 768, 1024, 1484]}
          sizes="(min-width: 64rem) 68vw, 100vw"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          alt={home.hero.imageAlt}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>{home.hero.caption}</figcaption>
      </figure>

      <p class="home-hero__note" aria-hidden="true">{home.hero.note}</p>
    </section>

    <section class="promise-strip" aria-label={home.promise.label}>
      {home.promise.items.map((promise) => (
        <article>
          <span class="promise-strip__icon" aria-hidden="true">{promise.icon}</span>
          <div><h2>{promise.heading}</h2><p>{promise.body}</p></div>
        </article>
      ))}
    </section>

    <section class="manifesto section-shell" aria-labelledby="manifesto-title">
      <div class="manifesto__heading">
        <p class="eyebrow">{home.manifesto.eyebrow}</p>
        <h2 id="manifesto-title">{home.manifesto.heading}</h2>
      </div>
      <div class="manifesto__copy">
        {home.manifesto.paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
      </div>
      <div class="manifesto__stamp" aria-hidden="true">
        <span class="manifesto__stamp-name">{copy.shared.brand.name}</span><span>{home.manifesto.stamp}</span>
      </div>
    </section>

    <section class="current-collection section-shell" aria-labelledby="collection-title">
      <header class="section-heading">
        <div>
          <p class="eyebrow">{home.collection.eyebrow}</p>
          <h2 id="collection-title">{collectionHeading[0]}<br />{collectionHeading[1]}</h2>
        </div>
        <p>{home.collection.intro}</p>
      </header>

      <div class="collection-grid">
        <a class="artwork-feature" href={`/artworks/${featuredBeachHuts.handle}`} aria-label={`Explore ${featuredBeachHuts.title}`}>
          <Picture
            src={beachHutsImage}
            widths={[480, 720, 960, 1484]}
            sizes="(min-width: 48rem) 50vw, 100vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            alt={featuredBeachHuts.alt}
            loading="lazy"
          />
          <span class="artwork-feature__caption">
            <span><strong>{featuredBeachHuts.title}</strong><small>{featuredBeachHuts.placeName} · East Sussex</small></span>
            <span aria-hidden="true">{home.collection.view}</span>
          </span>
        </a>

        <a class="artwork-feature" href={`/artworks/${featuredHarbour.handle}`} aria-label={`Explore ${featuredHarbour.title}`}>
          <Picture
            src={harbourImage}
            widths={[480, 720, 960, 1484]}
            sizes="(min-width: 48rem) 50vw, 100vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            alt={featuredHarbour.alt}
            loading="lazy"
          />
          <span class="artwork-feature__caption">
            <span><strong>{featuredHarbour.title}</strong><small>{featuredHarbour.placeName} · East Sussex</small></span>
            <span aria-hidden="true">{home.collection.view}</span>
          </span>
        </a>
      </div>
    </section>

    <section class="browse-callout section-shell" aria-labelledby="browse-title">
      <p class="eyebrow">{home.browse.eyebrow}</p>
      <h2 id="browse-title">{browseHeading[0]}<br />{browseHeading[1]}</h2>
      <a class="button-link button-link--navy" href="/artworks">
        {home.browse.cta} <span aria-hidden="true">→</span>
      </a>
      <p class="browse-callout__annotation" aria-hidden="true">{browseAnnotation[0]}<br />{browseAnnotation[1]}</p>
    </section>

    <section class="process section-shell" aria-labelledby="process-title">
      <div class="process__intro">
        <p class="eyebrow">{home.process.eyebrow}</p>
        <h2 id="process-title">{home.process.heading}</h2>
        <p class="process__body">{home.process.body}</p>
        <a class="text-link" href="/our-story">{home.process.cta} <span aria-hidden="true">→</span></a>
      </div>
      <ol class="process__steps">
        {home.process.steps.map((step) => (
          <li><span class="process__number">{step.number}</span><div><h3>{step.heading}</h3><p class="process__description">{step.body}</p></div></li>
        ))}
      </ol>
    </section>
  </main>
</BaseLayout>
