---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImage from '../assets/home/hero-eastbourne-flower-bed.jpg';
import beachHutsImage from '../assets/home/current-beach-huts.jpg';
import harbourImage from '../assets/home/current-sovereign-harbour.jpg';
import '../styles/home.scss';
import { siteCopy } from '../domain/site-copy';

const title = siteCopy.home.title;
const description = siteCopy.home.description;
const home = siteCopy.home;
const canonical = new URL('/', Astro.site ?? Astro.url.origin).href;
const socialImage = new URL(heroImage.src, Astro.site ?? Astro.url.origin).href;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Paperseal',
    url: canonical,
    description,
    areaServed: 'United Kingdom',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Paperseal',
    url: canonical,
    inLanguage: 'en-GB',
  },
];
---
<BaseLayout
  {title}
  {description}
  {canonical}
  image={socialImage}
  {structuredData}
  bodyClass="home-page"
>
  <main id="main-content">
    <section class="home-hero" aria-labelledby="home-hero-title">
      <div class="home-hero__copy">
        <p class="eyebrow">{home.heroEyebrow}</p>
        <h1 id="home-hero-title">{home.heroHeading}</h1>
        <p class="home-hero__intro">{home.heroIntro}</p>
        <a class="button-link" href="/artworks">
          {home.heroCta} <span aria-hidden="true">→</span>
        </a>
      </div>

      <figure class="home-hero__art">
        <Picture
          src={heroImage}
          widths={[480, 768, 1024, 1484]}
          sizes="(min-width: 64rem) 68vw, 100vw"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          alt={home.heroAlt}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>{home.heroCaption}</figcaption>
      </figure>

      <p class="home-hero__note" aria-hidden="true">{home.heroNote}</p>
    </section>

    <section class="promise-strip" aria-label={home.promiseLabel}>
      {home.promises.map((promise, index) => (
        <article>
          <span class="promise-strip__icon" aria-hidden="true">{['⌁', '♡', '✦', '≈'][index]}</span>
          <div><h2>{promise.title}</h2><p>{promise.copy}</p></div>
        </article>
      ))}
    </section>

    <section class="manifesto section-shell" aria-labelledby="manifesto-title">
      <div class="manifesto__heading">
        <p class="eyebrow">{home.manifestoEyebrow}</p>
        <h2 id="manifesto-title">{home.manifestoHeading}</h2>
      </div>
      <div class="manifesto__copy">
        {home.manifestoParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="manifesto__stamp" aria-hidden="true">
        <span class="manifesto__stamp-name">Paperseal</span><span>Always a good idea</span>
      </div>
    </section>

    <section class="current-collection section-shell" aria-labelledby="collection-title">
      <header class="section-heading">
        <div>
          <p class="eyebrow">{home.collectionEyebrow}</p>
          <h2 id="collection-title">{home.collectionHeading[0]}<br />{home.collectionHeading[1]}</h2>
        </div>
        <p>{home.collectionIntro}</p>
      </header>

      <div class="collection-grid">
        <a class="artwork-feature" href="/artworks/beach-huts-eastbourne-ps-007" aria-label="Explore Beach Huts, Eastbourne">
          <Picture
            src={beachHutsImage}
            widths={[480, 720, 960, 1484]}
            sizes="(min-width: 48rem) 50vw, 100vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            alt="Beach Huts, Eastbourne shown as a framed print on a warm textured wall"
            loading="lazy"
          />
          <span class="artwork-feature__caption">
            <span><strong>Beach Huts, Eastbourne</strong><small>Eastbourne · East Sussex</small></span>
            <span aria-hidden="true">View print →</span>
          </span>
        </a>

        <a class="artwork-feature" href="/artworks/sovereign-harbour-ps-003" aria-label="Explore Sovereign Harbour">
          <Picture
            src={harbourImage}
            widths={[480, 720, 960, 1484]}
            sizes="(min-width: 48rem) 50vw, 100vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            alt="Sovereign Harbour at sunset shown as a framed Paperseal print above a wooden sideboard"
            loading="lazy"
          />
          <span class="artwork-feature__caption">
            <span><strong>Sovereign Harbour</strong><small>Eastbourne · East Sussex</small></span>
            <span aria-hidden="true">View print →</span>
          </span>
        </a>
      </div>
    </section>

    <section class="browse-callout section-shell" aria-labelledby="browse-title">
      <p class="eyebrow">{home.browseEyebrow}</p>
      <h2 id="browse-title">{home.browseHeading[0]}<br />{home.browseHeading[1]}</h2>
      <a class="button-link button-link--navy" href="/artworks">
        {home.browseCta} <span aria-hidden="true">→</span>
      </a>
      <p class="browse-callout__annotation" aria-hidden="true">Local places.<br />Brighter rooms.</p>
    </section>

    <section class="process section-shell" aria-labelledby="process-title">
      <div class="process__intro">
        <p class="eyebrow">{home.processEyebrow}</p>
        <h2 id="process-title">{home.processHeading}</h2>
        <p class="process__body">{home.processBody}</p>
        <a class="text-link" href="/our-story">{home.processCta} <span aria-hidden="true">→</span></a>
      </div>
      <ol class="process__steps">
        {home.processSteps.map((step, index) => (
          <li><span class="process__number">{String(index + 1).padStart(2, '0')}</span><div><h3>{step.title}</h3><p class="process__description">{step.copy}</p></div></li>
        ))}
      </ol>
    </section>
  </main>
</BaseLayout>
