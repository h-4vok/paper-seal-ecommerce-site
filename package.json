{
  "name": "paperseal-ecommerce-site",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . && stylelint \"src/**/*.{css,scss}\"",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "astro check",
    "check:copy": "node scripts/check-copy-source.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir storybook-build",
    "sync:shopify": "tsx scripts/sync-shopify.ts",
    "capture:visual": "tsx scripts/capture-visual-evidence.ts",
    "assets:home": "node scripts/build-home-assets.mjs",
    "assets:artworks": "node scripts/build-artwork-assets.mjs",
    "content:build:metadata": "node scripts/build-content-metadata.mjs",
    "content:build:assets": "node scripts/build-artwork-assets.mjs",
    "content:build": "bun run content:build:metadata && bun run content:build:assets",
    "prepare": "husky",
    "validate": "bun run check:copy && bun run lint && bun run format && bun run typecheck && bun run test && bun run build",
    "check": "npm run validate && npm run test:e2e && npm run build-storybook"
  },
  "dependencies": {
    "@astrojs/react": "^4.3.0",
    "astro": "^5.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitest/coverage-v8": "^3.2.4",
    "astro-eslint-parser": "^1.2.2",
    "checkly": "^9.5.0",
    "eslint": "^9.35.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "sass": "^1.92.1",
    "sharp": "^0.34.5",
    "storybook": "8.6.18",
    "stylelint": "^16.24.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
